{
  "mcpServers": {
    "bleavit-foresight": {
      "type": "http",
      "url": "https://api.foresight.bleavit.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://auth.foresight.bleavit.com/oauth/register",
            "baseScopes": ["mcp:read", "mcp:write", "offline_access"]
          }
        }
      }
    }
  }
}
